# Copy to .env next to compose.yaml.
TZ=Asia/Kuala_Lumpur
# This server's Tailscale IPv4 address (`tailscale ip -4`); setup.sh fills it in.
TAILSCALE_IP=

# Phase 2 (voice profile)
WHISPER_MODEL=small
# Try `ms` too: Manglish commands may transcribe better with Malay as the base language.
WHISPER_LANGUAGE=en
PIPER_VOICE=en_US-lessac-medium
